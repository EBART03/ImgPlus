{
    "name": "ImagePlus",
    "description": "Image Pin Extension",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup/display.html",
        "default_icon": "images/Icon.png"    
    },
    "host_permissions": [
        "http://*/*",
        "https://*/*"
        ],
    "background": {
        "service_worker": "scripts/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/content.js"],
            "run_at": "document_start",
            "type": "module"
        }
    ],
    "permissions": [
        "contextMenus",
        "clipboardRead",
        "clipboardWrite",
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "downloads"
    ],
    "web_accessible_resources": [
        {
            "resources": ["scripts/imageSelection.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "commands": {
        "activate-image-selection": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y"
            },
            "description": "Activate image selection"
        }
    },
    "icons": {
        "16": "images/Icon_16.png"
    }
}
